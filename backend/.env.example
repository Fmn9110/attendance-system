# 复制为 .env 并按需修改
APP_NAME=AttendanceSystem
DEBUG=false
# SQLite 示例
DATABASE_URL=sqlite:///./data/attendance.db
# MySQL 示例（保留切换能力）：
# DATABASE_URL=mysql+pymysql://user:pass@localhost/attendance?charset=utf8mb4
# PostgreSQL 示例：
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost/attendance

# 请改为随机长字符串
SECRET_KEY=please-change-me-to-a-random-long-secret
# 登录态保持时长（天）
SESSION_EXPIRE_DAYS=7
# 上传大小限制（MB）
MAX_UPLOAD_MB=5
# 上传目录
UPLOAD_DIR=./uploads
